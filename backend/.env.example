# Server Configuration
PORT=3000
NODE_ENV=development

# Database Settings
DATABASE_URL=postgresql://db_user:db_password@localhost:5432/mealbot

# Redis Cache Settings
REDIS_URL=redis://localhost:6379

# Cryptographic Keys (AES-256-GCM encryption for OAuth tokens)
ENCRYPTION_KEY=your-32-byte-aes-encryption-key-here
JWT_SECRET=your-jwt-signing-secret-here

# Anthropic Claude API Key
ANTHROPIC_API_KEY=your-claude-api-key-here

# Twilio WhatsApp Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Swiggy MCP Service Configuration
SWIGGY_CLIENT_ID=your-swiggy-mcp-client-id
SWIGGY_CLIENT_SECRET=your-swiggy-mcp-client-secret
SWIGGY_OAUTH_REDIRECT_URI=http://localhost:3000/auth/swiggy/callback
